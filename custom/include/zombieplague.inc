/*
 * Прослойка совместимости: ZP 4.3 -> ZP 4.4 Fix5a.
 *
 * Плагины из чужих сборок написаны под Zombie Plague 4.3 и подключают
 * <zombieplague>. У нас 4.4, где файл зовётся zombie_plague_v44.
 *
 * Прослойка тонкая намеренно — переходной логики здесь нет и быть не должно.
 * Это проверено, а не предположено: сверка обоих include-файлов показала, что
 * ВСЕ 35 нативов, все форварды и все константы 4.3 присутствуют в 4.4 с теми
 * же именами. Расхождений ноль, поэтому достаточно переименования.
 *
 * ВНИМАНИЕ, грабли: своего охранного макроса здесь БЫТЬ НЕ ДОЛЖНО.
 * zombie_plague_v44.inc охраняется макросом с тем же именем —
 * _zombieplague_included. Объявив его тут, мы заставим настоящий файл выйти
 * по #endinput сразу же, и ни один натив не определится. Ошибка при этом
 * будет невнятная: «undefined symbol zp_get_user_zombie» в чужом плагине.
 *
 * Проверить прослойку заново после обновления мода:
 *   comm -23 <(grep -oE 'native [a-z_0-9]+' zombieplague.inc | sort -u) \
 *            <(grep -oE 'native [a-z_0-9]+' zombie_plague_v44.inc | sort -u)
 * Пустой вывод — прослойка по-прежнему верна.
 */

#include <zombie_plague_v44>
