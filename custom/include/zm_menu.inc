/*
 * Меню, которое влезает в экран целиком.
 *
 * ⚠️⚠️ У КЛИЕНТА БУФЕР МЕНЮ — 512 БАЙТ, И ЛИШНЕЕ ОН ВЫБРАСЫВАЕТ МОЛЧА.
 * В движке Half-Life за текст меню отвечает CHudMenu::m_szMenuString[512]:
 * приходящие куски дописываются в него, пока помещаются, а хвост просто
 * теряется. Ни ошибки, ни многоточия — последние пункты пропадают, и выглядит
 * это как «текст в меню не виден до конца». Жалоба владельца была ровно такой,
 * и «в основном где длинные названия» — точная примета: рвётся там, где имена
 * длинные.
 *
 * ⚠️ РУССКАЯ БУКВА — ДВА БАЙТА. Строка «Штурмовая винтовка HK416» занимает не
 * 24 байта, а 41. Поэтому семь пунктов русского меню с заголовком в три строки
 * упираются в предел, хотя на глаз кажутся короткими.
 *
 * Считать вручную бесполезно: имена правит владелец, цены и метки уровней
 * дописываются на ходу. Поэтому меню само решает, сколько пунктов класть на
 * страницу: измеряем САМЫЙ ДЛИННЫЙ пункт и делим остаток буфера на него.
 *
 * Как пользоваться:
 *
 *     new longest = 0
 *     for (...) { formatex(line, ...); zm_menu_seen(longest, line); menu_additem(...) }
 *     zm_menu_fit(menu, title, longest)
 *     menu_display(id, menu)
 */

#if defined _zm_menu_included
    #endinput
#endif
#define _zm_menu_included

#include <amxmodx>

// Столько байт клиент вообще способен показать.
#define ZM_MENU_LIMIT 512

// Запас на служебные строки самого AMXX: номера пунктов «1. », перевод строки
// после каждого, «8. Назад», «9. Далее», «0. Выход» и завершающий ноль.
#define ZM_MENU_TAIL 90

/** Запомнить длину пункта: длиннейший и решает, сколько их влезет. */
stock zm_menu_seen(&longest, const line[])
{
    new len = strlen(line)
    if (len > longest) longest = len
}

/**
 * Поставить меню столько пунктов на страницу, чтобы страница влезла в буфер.
 * Возвращает выбранное число — по нему удобно проверять в тестах.
 */
stock zm_menu_fit(menu, const title[], longest)
{
    // Каждый пункт съедает свою длину плюс «N. » и перевод строки.
    new cost = longest + 4
    new room = ZM_MENU_LIMIT - strlen(title) - ZM_MENU_TAIL
    new fit = room / (cost > 0 ? cost : 1)

    // Меньше трёх пунктов на странице — это уже издевательство: значит рвать
    // надо не страницу, а сами названия. Больше семи AMXX и сам не кладёт.
    if (fit < 3) fit = 3
    if (fit > 7) fit = 7

    menu_setprop(menu, MPROP_PERPAGE, fit)
    return fit
}
