/*
 * Общий доступ к базе данных для наших плагинов.
 *
 * ЗАЧЕМ ОДИН ФАЙЛ НА ВСЕХ. Прогресс, ножи, скины и статистика лежат в разных
 * плагинах, но ключ у них один и тот же (SteamID), беды тоже одни и те же, и
 * разъехаться им нельзя. Раньше ключ строился в трёх местах тремя копиями —
 * и когда выяснилось, что на входе в игру SteamID ещё нет, чинить пришлось
 * каждую копию отдельно.
 *
 * ЧТО ЗДЕСЬ ВАЖНО ЗНАТЬ:
 *
 *  1. ⚠️ ЗАПРОСЫ ТОЛЬКО ПОТОКОВЫЕ (SQL_ThreadQuery). Обычный SQL_Execute
 *     останавливает ВЕСЬ сервер, пока база отвечает. База у нас на другой
 *     машине, ответ идёт десятки миллисекунд, и каждый вход игрока стал бы
 *     подвисанием у всех тридцати двух. Это и есть та самая «сервер лагает на
 *     заходе», на которую жалуются половина зомби-серверов.
 *
 *  2. ⚠️ ЭКРАНИРУЕМ ПРОСЕИВАНИЕМ, А НЕ SQL_QuoteString. Тому нужен хэндл
 *     открытого соединения, а у потокового запроса его нет. Поэтому всё, кроме
 *     букв, цифр и нескольких безопасных знаков, заменяем на «?». Ник игрока
 *     пишет чужой человек, и одинарной кавычке в нём нельзя дать ни единого
 *     шанса дойти до базы: одна такая кавычка — и запрос выполняет то, что
 *     придумал игрок, а не мы.
 *
 *  3. ⚠️ ЯЗЫК ЗАПРОСОВ — ОБЩИЙ ДЛЯ MySQL И SQLite. Никаких
 *     ON DUPLICATE KEY UPDATE и AUTO_INCREMENT: только CREATE TABLE IF NOT
 *     EXISTS, REPLACE INTO, SELECT и DELETE. Так одна и та же сборка работает
 *     и с базой на хостинге, и с файлом рядом — а переключение между ними
 *     остаётся правкой одной строки в configs/sql.cfg.
 *
 *  4. ⚠️ НЕ СОХРАНЯЕМ, ЕСЛИ НЕ ЗАГРУЗИЛИСЬ. Это правило соблюдает каждый
 *     плагин у себя, здесь его не спрятать, но написать надо один раз: если
 *     чтение из базы не удалось, игрок заходит пустым — и его выход ЗАТЁР БЫ
 *     всё накопленное. Потеря вышла бы необратимой, поэтому пустое состояние
 *     сохранять запрещено.
 *
 *  5. ⚠️⚠️ ЗАПРОСЫ РАЗВОДИМ ПО ВРЕМЕНИ (zm_db_when). AMXX на КАЖДЫЙ потоковый
 *     запрос открывает ОТДЕЛЬНОЕ соединение, а обрабатывает их по очереди одним
 *     рабочим потоком. На смене карты игроки заходят все разом, и четыре наших
 *     плагина шлют за каждого свой запрос: восемь игроков — это больше трёх
 *     десятков соединений в одну секунду к машине за 200 мс пути. Часть из них
 *     теряется по дороге («Can't connect to MySQL server (10060)»), каждая
 *     потерянная держит очередь до своего срока — и запросы, стоявшие за ней,
 *     не успевают ответить до конца карты. Проверено вживую на боевой базе:
 *     ножи и скины сохранились, прогресс и статистика — нет.
 */

#if defined _zm_db_included
    #endinput
#endif
#define _zm_db_included

#include <sqlx>

// Настройки соединения лежат в configs/sql.cfg, его собирает tools/db-config.mjs
// из custom/db.ini — файла вне репозитория, потому что там пароль.
new Handle:g_zm_db_tuple = Empty_Handle
new g_zm_db_cvar = 0

// Общий выключатель базы, один на все наши плагины. Ноль — работаем как
// раньше, только на файлах-хранилищах. Нужен не для красоты: если база начнёт
// капризничать посреди вечера, владелец должен уметь отключить её одной
// командой через rcon, не пересобирая сервер.
//
// ⚠️ Вызывать из plugin_init КАЖДОГО плагина. Повторная регистрация того же
// квара в AMXX безопасна — возвращается тот же указатель.
stock zm_db_init()
{
    g_zm_db_cvar = register_cvar("zp_use_db", "1")
}

stock bool:zm_db_on()
{
    return g_zm_db_cvar && get_pcvar_num(g_zm_db_cvar) != 0;
}

// Соединение заводим один раз на плагин: SQL_MakeStdTuple читает настройки из
// кваров, а они за время карты не меняются.
stock Handle:zm_db_tuple()
{
    if (g_zm_db_tuple == Empty_Handle) g_zm_db_tuple = SQL_MakeStdTuple()
    return g_zm_db_tuple;
}

// Просеиваем строку до безопасного вида. Не «экранируем» — именно выкидываем
// всё сомнительное: так нельзя ошибиться в одну сторону, а потерянный из ника
// смайлик беды не делает.
stock zm_db_safe(dest[], len, const src[])
{
    new j = 0
    for (new i = 0; src[i] && j < len - 1; i++)
    {
        new c = src[i]
        new bool:ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
            || (c >= '0' && c <= '9')
            || c == '_' || c == '-' || c == '.' || c == ':' || c == ' '
            // Кириллица в UTF-8 приходит парами байтов со старшим битом. Их
            // пропускаем: кавычек и точек с запятой среди них не бывает, а без
            // них русские ники в базе превратились бы в частокол вопросов.
            || (c & 0x80)
        dest[j++] = ok ? c : '?'
    }
    dest[j] = 0
    return j;
}

// Ключ игрока. Настоящий SteamID вида STEAM_0:1:N, иначе — по нику.
//
// ⚠️ ПРОВЕРЯЕМ ФОРМАТ, А НЕ ПРЕФИКС: под «начинается на STEAM_» подходит и
// STEAM_ID_LAN, и тогда ВСЕ игроки на сервере делят одну запись.
//
// ⚠️ given — ID, пришедший вместе с форвардом client_authorized. Спрашивать его
// у движка можно не всегда: на входе в игру его ещё может не быть, и
// get_user_authid отдаёт STEAM_ID_PENDING. Именно на этом терялся выбор ножа.
stock bool:zm_db_key(id, key[], len, const given[] = "")
{
    new authid[44]
    if (given[0]) copy(authid, charsmax(authid), given)
    else get_user_authid(id, authid, charsmax(authid))

    if (strlen(authid) > 9 && equal(authid, "STEAM_", 6)
        && authid[7] == ':' && (authid[8] == '0' || authid[8] == '1') && authid[9] == ':')
    {
        // ⚠️ ПРОСЕИВАЕМ ДАЖЕ SteamID. Проверка выше смотрит только начало
        // строки, а хвост у неё произвольный — и на сервере без Steam его
        // выдаёт ReUnion, а не Valve. Пропускать в запрос строку, за которую
        // никто не отвечает, нельзя ни при каких «да там же всегда цифры».
        zm_db_safe(key, len, authid)
        return true;
    }

    new name[32], safe[64]
    get_user_name(id, name, charsmax(name))
    zm_db_safe(safe, charsmax(safe), name)
    formatex(key, len, "ник:%s", safe)
    return false;
}

// Создать таблицу, если её ещё нет. Делаем это при старте карты каждым
// плагином: база может быть пустой (первый запуск, новый хостинг, чистая
// копия для проверки), и человек не обязан заводить таблицы руками.
//
// ⚠️⚠️ НЕ СРАЗУ, А ЧЕРЕЗ ПАУЗУ, И ЭТО НЕ ПЕРЕСТРАХОВКА. Настройки соединения
// лежат в configs/sql.cfg, а выполняет его штатный admin.amxx — командой
// server_cmd в своём plugin_cfg, то есть КОНЦОМ КАДРА, уже после нашего
// plugin_cfg. Соединение, построенное раньше, возьмёт заводские значения
// (mysql на 127.0.0.1 в базу «amx») и таким и останется на всю карту: мы его
// кэшируем. В журнале это выглядит как «Failed to set affinity from sqlite to
// mysql» — строчка, по которой ни за что не догадаться, что сохранение ушло
// не туда. Поймано живой проверкой tools/test-db.mjs.
new g_zm_db_sql[512]

stock zm_db_create(const sql[])
{
    copy(g_zm_db_sql, charsmax(g_zm_db_sql), sql)

    // Свой номер задачи: в плагинах уже есть задачи с номером 0, и remove_task(0)
    // у соседа снял бы нашу.
    remove_task(91100)
    set_task(2.0, "zm_db_create_now", 91100)
}

public zm_db_create_now()
{
    // Первое обращение к базе за карту — здесь же и рассказываем, куда именно
    // мы ходим. Без этой строки «данные не сохраняются» пришлось бы разбирать
    // вслепую: с виду всё работает, просто пишется в другую базу.
    new driver[16]
    SQL_GetAffinity(driver, charsmax(driver))
    log_amx("БАЗА: работаем через %s", driver)

    SQL_ThreadQuery(zm_db_tuple(), "zm_db_created", g_zm_db_sql)
}

// Обработчик создания таблицы. Объявлен здесь, чтобы каждый плагин не писал
// свой: единственное, что он делает, — громко жалуется, если база не отозвалась.
public zm_db_created(failstate, Handle:query, const error[], errnum, const data[], size, Float:queuetime)
{
    if (failstate == TQUERY_SUCCESS) return;

    log_amx("БАЗА: таблица не создана (%d): %s", errnum, error)
}

// Когда плагину слать свой запрос за этого игрока. База своя у каждого плагина,
// а очередь запросов — одна на сервер, поэтому и раздвигаем: своя доля секунды
// каждому игроку и своя базовая задержка каждому плагину (у прогресса 3.0,
// у ножей 3.4, у скинов 3.8 — они не сталкиваются даже у одного игрока).
// ⚠️ На SQLite задержка не нужна и только тормозит вход: файл рядом, очереди
// нет. Поэтому при sqlite раздвигаем вдесятеро мельче.
stock Float:zm_db_when(id, Float:base)
{
    new driver[16]
    SQL_GetAffinity(driver, charsmax(driver))
    new Float:step = equali(driver, "mysql") ? 0.2 : 0.02
    return base + float(id) * step
}

// Сколько ждать ответа, прежде чем считать, что его не будет. Потерянное
// соединение к чужому хостингу молчит десятками секунд, а игрок всё это время
// «не загружен» — то есть его прогресс НЕ СОХРАНИТСЯ до конца карты. Сторож
// разрешает читать зеркало на диске и жить дальше.
stock Float:zm_db_patience() return 15.0
