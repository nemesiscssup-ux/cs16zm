# Как git обращается с содержимым.
#
# ⚠️ ГЛАВНОЕ ЗДЕСЬ — ПЕРЕВОДЫ СТРОК В СКРИПТАХ. Windows по умолчанию ставит
# core.autocrlf=true, и при выгрузке репозитория на этой машине bash-скрипт
# получает окончания строк CRLF. Bash их не прощает: он читает возврат каретки
# как часть команды и отвечает `$'\r': command not found`. Ошибка выглядит
# бессмысленной, ищется долго, а появляется только у того, кто заново
# склонировал репозиторий, — то есть у следующего человека, а не у автора.
# Поэтому скриптам явно назначен LF, независимо от настроек машины.
*.sh   text eol=lf
*.mjs  text eol=lf
*.cmd  text eol=crlf

# Исходники плагинов компилирует amxxpc, ему всё равно, но правит их человек в
# редакторе — пусть будет одинаково у всех.
*.sma  text eol=lf
*.inc  text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf

# Содержимое игры трогать нельзя ничем: это двоичные файлы, и «исправление»
# переводов строк внутри модели — это испорченная модель. Расширения перечислены
# явно, а не отданы на угадывание.
*.mdl binary
*.spr binary
*.wav binary
*.bmp binary
*.tga binary
*.wad binary
*.bsp binary
*.png binary
*.amxx binary
