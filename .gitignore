# Карантин: скачанные сборки. Не в репозиторий — вес и происхождение чужие.
# Доказательная база сохраняется в quarantine/*/meta.json (они ниже разрешены).
quarantine/*/archive/
quarantine/*/extracted/

# Скачанный апстрим: восстанавливается командой node tools/fetch-upstream.mjs
upstream/linux/
upstream/windows/
upstream/common/
upstream/legacy/
upstream/reference/

# Собранный сервер и пакеты — продукт сборки
server/
dist/
build/test/*.amxx
build/zp-test/

# Рабочий каталог локального прогона и базовые файлы игры от SteamCMD
run/
build/hlds-base/
build/steamcmd/

# Учётные записи администраторов — в них пароли, в репозиторий им нельзя.
# Заводятся командой: node tools/add-admin.mjs --help
custom/admins.ini

# Доступ к базе данных: адрес, логин и ПАРОЛЬ. Нет файла — сборка идёт на
# SQLite, то есть на файл рядом с сервером. Образец: custom/db.ini.example
custom/db.ini

# Мусор от неудачного перенаправления в cmd: имя nul на Windows занято
# устройством, файл с таким именем не открывается ничем, и git на нём падает
# с «unable to index file».
nul
nul.*
