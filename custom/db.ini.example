# Доступ к базе данных. СКОПИРУЙТЕ этот файл в custom/db.ini и впишите свои
# значения — оригинал остаётся образцом и лежит в репозитории, а копия в него
# не попадает (она в .gitignore, потому что содержит пароль).
#
# ⚠️ ЭТО БАЗА САЙТА, а не хостинга раздачи. Она на 95.213.255.80 и ОБЩАЯ:
# сайт держит там zm_privileges со сроками и представление zm_admins, сервер
# читает его и пишет рядом свои zm_progress, zm_knife, zm_skin, zm_stats.
# Схема сайта заводится так:  node tools/mysql.mjs --file site/sql/schema.sql
# Подробности — docs/2026-08-11-site-integration.md.
#
# ⚠️ ПОЛЬЗОВАТЕЛЬ НУЖЕН ОТДЕЛЬНЫЙ, НЕ ТОТ, ЧТО У САЙТА. У сайта полные права на
# базу, и его пароль в файлах игрового сервера — это доступ к заказам и игровым
# паролям для всех, кто эти файлы видит. Игровому серверу нужно ровно столько:
#
#   GRANT SELECT ON `база`.`zm_admins`   TO 'игровой'@'%';   -- привилегии, чтение
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `база`.`zm_progress` TO 'игровой'@'%';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `база`.`zm_knife`    TO 'игровой'@'%';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `база`.`zm_skin`     TO 'игровой'@'%';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `база`.`zm_stats`    TO 'игровой'@'%';
#
# ⚠️ «@'%'» ОБЯЗАТЕЛЬНО. Игровой сервер стучится снаружи, с чужого адреса; у
# пользователя без этого вход разрешён только с самой машины базы, и соединение
# обрывается без внятной причины. В логе сервера это будет «SQL_CANT_CON».
#
# ⚠️ localhost В host НЕ ПИСАТЬ: клиент MySQL пойдёт искать файл-сокет, которого
# на другой машине нет. Только адрес.
#
# ⚠️ НЕТ ЭТОГО ФАЙЛА — НЕ ПОЛОМКА. Тогда сборка идёт на SQLite: база одним
# файлом рядом с сервером, настраивать нечего. Так собираются проверки и любая
# свежая копия репозитория.

host = 95.213.255.80
user = ваш_игровой_пользователь
pass = ваш_пароль
db   = база_сайта
